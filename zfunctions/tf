local workspace cmd varFile workVars opt outFile rawFile rc
local useOut=0
local -a args=()

# Determine if terraform needed from "required_version" parameter
function ver { printf "%03d%03d%03d%03d" $(echo "$1" | tr '.' ' '); }
req_ver=$(find . -name "*.tf" -exec  awk -F'[" ]' '/required_version/ {print $(NF-1)}' '{}' \; | sort -V | tail -1)
[[ $(ver $req_ver) -gt $(ver 1.11) ]] && tf=terraform || tf=tofu

workspace="$(${tf} workspace show)"
cmd=$1; shift

# Pull out -o|--out|--output (optional filename) and keep everything else
while (( $# )); do
    case $1 in
        -o|--out|--output)
            useOut=1; shift
            if (( $# )) && [[ $1 != -* ]]; then outFile=$1; shift; fi
            ;;
        *) args+=("$1"); shift ;;
    esac
done
set -- "${args[@]}"

case $cmd in
    a|apply)
        cmd="apply"
        opt="my.plan"
        [[ -t 1 ]] && clear
        ;;
    destroy)
        [[ "${workspace}" != "default" ]] && [[ -f ${workspace}.tfvars ]] && workVars="-var-file=${workspace}.tfvars"
        cmd="destroy"
        [[ -t 1 ]] && clear
        ;;
    i|iu|init)
        [[ ${cmd:1:2} == "u" ]] && opt="-upgrade"
        cmd="init"
        ;;
    p|plan)
        [[ "${workspace}" != "default" ]] && [[ -f ${workspace}.tfvars ]] && workVars="-var-file=${workspace}.tfvars"
        opt="-out=my.plan"
        cmd="plan"
        [[ -t 1 ]] && clear
        ;;
    s?|state)
        case ${cmd:1:2} in
          l) opt="list"; [[ $# > 1 ]] && shift;;
          s) opt="show"; [[ $# > 1 ]] && shift;;
        esac
        cmd="state"
        ;;
    v|validate)
        cmd="validate"
        ;;
    w|workspace)
        cmd="workspace"
        ;;
esac

# -o with no filename writes my.<command>.txt, matching my.plan.txt and my.apply.txt
(( useOut )) && [[ -z ${outFile:-} ]] && outFile="my.${cmd}.txt"

echo \-\> ${tf} ${cmd} ${opt} ${varFile} ${workVars}  ${@}

if (( useOut )); then
    # script gives OpenTofu a terminal, so color stays on screen; the log is then stripped to plain text
    rawFile=$(mktemp)
    script -q "${rawFile}" ${tf} ${cmd} ${varFile} ${opt} ${workVars} ${@}
    rc=$?
    sed -E $'s/\e\\[[0-9;?]*[A-Za-z]//g' "${rawFile}" | tr -d '\r' > "${outFile}"
    rm -f "${rawFile}"
    echo "-> plaintext copy written to ${outFile}"
    return ${rc}
else
    ${tf} ${cmd} ${varFile} ${opt} ${workVars} ${@}
fi